{
  "name": "whale-maid",
  "displayName": "鲸鱼娘看板娘",
  "description": "资源管理器里的鲸鱼娘女仆，会跟着你写代码的状态换表情。美术：上善 / ZipZipPipe（CC BY-NC-SA 4.0）",
  "version": "0.1.0",
  "publisher": "local",
  "license": "SEE LICENSE IN NOTICE.md",
  "engines": {
    "vscode": "^1.80.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "views": {
      "explorer": [
        {
          "type": "webview",
          "id": "whaleMaid.view",
          "name": "鲸鱼娘"
        }
      ]
    },
    "commands": [
      {
        "command": "whaleMaid.pat",
        "title": "摸摸头",
        "category": "鲸鱼娘"
      }
    ],
    "configuration": {
      "title": "鲸鱼娘看板娘",
      "properties": {
        "whaleMaid.sleepAfterMinutes": {
          "type": "number",
          "default": 3,
          "description": "多少分钟没有操作后鲸鱼娘会睡着。"
        },
        "whaleMaid.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "在状态栏显示鲸鱼娘的台词。"
        }
      }
    }
  }
}
