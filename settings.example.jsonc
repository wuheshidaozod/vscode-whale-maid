// 复制到 VS Code 的 settings.json（Ctrl+Shift+P → "Preferences: Open User Settings (JSON)"）
// 把 <你的用户名> 换成你自己的；放在别的目录就改成对应路径。
{
  "vscode_custom_css.imports": [
    "file:///C:/Users/<你的用户名>/.vscode-whale/whale.css"
  ],
  "workbench.colorCustomizations": {
    "editorStickyScroll.background": "#0a1636",
    "editorStickyScrollHover.background": "#13275a",
    "welcomePage.tileBackground": "#0e1d45cc",
    "welcomePage.tileHoverBackground": "#18306acc",
    "welcomePage.tileBorder": "#c5a46866",
    "welcomePage.progress.foreground": "#c5a468",
    "welcomePage.progress.background": "#1c3266",
    "focusBorder": "#c5a46888",
    "foreground": "#d9e0f0",
    "descriptionForeground": "#9fb0d4",
    "textLink.foreground": "#e2c88f",
    "textLink.activeForeground": "#f3dca8",
    "selection.background": "#3b5bab88",
    "widget.shadow": "#02061499",
    "progressBar.background": "#c5a468",
    "titleBar.activeBackground": "#070f28",
    "titleBar.inactiveBackground": "#070f28",
    "titleBar.activeForeground": "#e2c88f",
    "titleBar.inactiveForeground": "#8b97b8",
    "titleBar.border": "#c5a46855",
    "activityBar.background": "#070f28",
    "activityBar.foreground": "#e2c88f",
    "activityBar.inactiveForeground": "#6f7ea8",
    "activityBar.activeBorder": "#c5a468",
    "activityBar.border": "#c5a46833",
    "activityBarBadge.background": "#c5a468",
    "activityBarBadge.foreground": "#0b193f",
    "sideBar.background": "#0b193f",
    "sideBar.foreground": "#cdd6ec",
    "sideBar.border": "#c5a46833",
    "sideBarTitle.foreground": "#e2c88f",
    "sideBarSectionHeader.background": "#0e2150",
    "sideBarSectionHeader.foreground": "#e2c88f",
    "sideBarSectionHeader.border": "#c5a46833",
    "list.activeSelectionBackground": "#22407f",
    "list.activeSelectionForeground": "#ffffff",
    "list.inactiveSelectionBackground": "#18306a",
    "list.hoverBackground": "#14295c",
    "list.focusOutline": "#c5a46888",
    "list.highlightForeground": "#e2c88f",
    "tree.indentGuidesStroke": "#c5a46844",
    "editor.background": "#0a1636",
    "editor.foreground": "#dbe3f5",
    "editor.lineHighlightBackground": "#13275a66",
    "editor.lineHighlightBorder": "#00000000",
    "editor.selectionBackground": "#3b5bab77",
    "editor.inactiveSelectionBackground": "#3b5bab44",
    "editor.findMatchBackground": "#c5a46866",
    "editor.findMatchHighlightBackground": "#c5a46833",
    "editorCursor.foreground": "#e2c88f",
    "editorLineNumber.foreground": "#4a5b8a",
    "editorLineNumber.activeForeground": "#e2c88f",
    "editorIndentGuide.background1": "#1c3266",
    "editorIndentGuide.activeBackground1": "#c5a46866",
    "editorBracketMatch.border": "#c5a468",
    "editorBracketMatch.background": "#c5a46822",
    "editorWidget.background": "#0e1d45",
    "editorWidget.border": "#c5a46866",
    "editorSuggestWidget.background": "#0e1d45",
    "editorSuggestWidget.selectedBackground": "#22407f",
    "editorHoverWidget.background": "#0e1d45",
    "editorHoverWidget.border": "#c5a46866",
    "editorGutter.background": "#0a1636",
    "minimap.background": "#0a163600",
    "scrollbarSlider.background": "#c5a46830",
    "scrollbarSlider.hoverBackground": "#c5a46855",
    "scrollbarSlider.activeBackground": "#c5a46888",
    "editorGroupHeader.tabsBackground": "#081230",
    "editorGroupHeader.tabsBorder": "#c5a46855",
    "editorGroup.border": "#c5a46833",
    "tab.activeBackground": "#0a1636",
    "tab.activeForeground": "#f3dca8",
    "tab.activeBorderTop": "#c5a468",
    "tab.activeBorder": "#0a1636",
    "tab.inactiveBackground": "#081230",
    "tab.inactiveForeground": "#7f8db3",
    "tab.hoverBackground": "#10224f",
    "tab.border": "#c5a46822",
    "breadcrumb.background": "#0a1636",
    "breadcrumb.foreground": "#8d9cc4",
    "panel.background": "#081230",
    "panel.border": "#c5a46866",
    "panelTitle.activeBorder": "#c5a468",
    "panelTitle.activeForeground": "#e2c88f",
    "panelTitle.inactiveForeground": "#7f8db3",
    "terminal.background": "#081230",
    "terminal.foreground": "#d9e0f0",
    "terminalCursor.foreground": "#e2c88f",
    "statusBar.background": "#0b193f",
    "statusBar.foreground": "#e2c88f",
    "statusBar.border": "#c5a46866",
    "statusBar.noFolderBackground": "#0b193f",
    "statusBar.debuggingBackground": "#7a3b52",
    "statusBarItem.hoverBackground": "#c5a46833",
    "statusBarItem.remoteBackground": "#c5a468",
    "statusBarItem.remoteForeground": "#0b193f",
    "button.background": "#c5a468",
    "button.foreground": "#0b193f",
    "button.hoverBackground": "#d8bb82",
    "button.secondaryBackground": "#1c3266",
    "button.secondaryForeground": "#e2c88f",
    "badge.background": "#c5a468",
    "badge.foreground": "#0b193f",
    "input.background": "#0e1d45",
    "input.border": "#c5a46844",
    "inputOption.activeBorder": "#c5a468",
    "dropdown.background": "#0e1d45",
    "dropdown.border": "#c5a46844",
    "checkbox.background": "#0e1d45",
    "checkbox.border": "#c5a46866",
    "quickInput.background": "#0e1d45",
    "quickInputList.focusBackground": "#22407f",
    "menu.background": "#0e1d45",
    "menu.foreground": "#d9e0f0",
    "menu.selectionBackground": "#22407f",
    "menu.border": "#c5a46866",
    "notifications.background": "#0e1d45",
    "notifications.border": "#c5a46866",
    "notificationCenterHeader.background": "#0b193f"
  }
}
